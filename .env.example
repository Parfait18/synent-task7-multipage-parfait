# Copy to .env.local (never commit real values).

# Public URL of the site, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Number of trusted reverse proxies in front of the app that append to X-Forwarded-For.
# Leave empty (0) when the app is reached directly: the contact rate limit then uses
# one shared budget instead of trusting a header the client can forge.
# Not needed on Vercel, where x-vercel-forwarded-for is used automatically.
TRUSTED_PROXY_HOPS=
